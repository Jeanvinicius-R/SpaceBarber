# Copy to .env.whatsapp, fill locally, and restart the server.
# Keep false until the number, access token and approved templates are ready.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Choose a currently supported Graph API version in your Meta app, e.g. vNN.0.
WHATSAPP_API_VERSION=
WHATSAPP_CONFIRMATION_TEMPLATE=spacebarber_confirmacao
WHATSAPP_REMINDER_TEMPLATE=spacebarber_lembrete
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
